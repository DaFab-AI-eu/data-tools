# Sentinel-2
# Example: S2A_MSIL2A_20250322T103741_N0511_R008_T32ULB_20250322T161215  (asset WVP_10m, image/jp2)
#   dir:  CDSE:S2A:MSIL2A:T32ULB
#   file: 05.11:2025-03-22:103741:20250322T161215
#   key:  8:WVP_10m:image_jp2
[ source, mission=S2A/S2B/S2C, level, gridcode
    [ procver, takedate, taketime, procdate
        [ orbit, asset_name, mediatype ]]]

# Sentinel-1 RTC from the Microsoft Planetary Computer
# Example: S1A_IW_GRDH_1SDV_20211220T182141_20211220T182206_041096_04E1DB_rtc (asset vv, image/tiff)
#   dir:  MPC:S1A:IW:GRDH:2021-12-20
#   file: DV:182141:182206
#   key:  41096:vv:image_tiff
[ source=MPC, mission=S1A/S1B/S1C/S1D, mode, type, takedate
    [ polarization, taketime, stoptime
        [ orbit, asset_name, mediatype ]]]
